#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Ask a running kobiQ instance to show (Wayland-safe, no Qt startup)."""

import argparse
import os
import shutil
import socket
import subprocess
import sys

SERVICE = "org.kobiq.Application"
OBJECT_PATH = "/org/kobiq/Application"
RUNTIME = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
SOCKET = f"{RUNTIME}/kobiq/instance.sock"
TOKEN = os.environ.get("XDG_ACTIVATION_TOKEN") or os.environ.get("DESKTOP_STARTUP_ID", "")


def log(verbose: bool, message: str) -> None:
    if verbose:
        print(message, file=sys.stderr)


def show_via_socket(verbose: bool) -> bool:
    message = "show"
    if TOKEN:
        message += "\n" + TOKEN
    payload = message.encode()

    if not os.path.exists(SOCKET):
        log(verbose, f"socket missing: {SOCKET}")
        return False

    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.settimeout(2)
    try:
        sock.connect(SOCKET)
        sock.sendall(payload)
        response = sock.recv(8)
        if response.startswith(b"ok"):
            log(verbose, f"show acknowledged via {SOCKET}")
            return True
        log(verbose, f"no ack from kobiQ ({response!r})")
        return False
    except OSError as exc:
        log(verbose, f"socket connect failed: {exc}")
        return False
    finally:
        sock.close()


def show_via_dbus(verbose: bool) -> bool:
    if shutil.which("gdbus") is None:
        log(verbose, "gdbus not found")
        return False

    if TOKEN:
        escaped = TOKEN.replace("'", "\\'")
        platform_data = f"{{'activation-token': <'{escaped}'>}}"
    else:
        platform_data = "{}"

    try:
        subprocess.run(
            [
                "gdbus",
                "call",
                "--session",
                "--dest",
                SERVICE,
                "--object-path",
                OBJECT_PATH,
                "--method",
                "org.freedesktop.Application.Activate",
                platform_data,
            ],
            check=True,
            capture_output=True,
            timeout=3,
        )
        log(verbose, "sent show request via D-Bus")
        return True
    except (subprocess.CalledProcessError, subprocess.TimeoutExpired, FileNotFoundError) as exc:
        log(verbose, f"dbus call failed: {exc}")
        return False


def main() -> int:
    parser = argparse.ArgumentParser(description="Show the running kobiQ window")
    parser.add_argument("-v", "--verbose", action="store_true", help="print debug output")
    args = parser.parse_args()

    log(args.verbose, f"socket={SOCKET}")
    log(args.verbose, f"token={'set' if TOKEN else 'empty'}")

    if show_via_socket(args.verbose):
        return 0

    if TOKEN and show_via_dbus(args.verbose):
        return 0

    kobiq = shutil.which("kobiQ")
    if not kobiq:
        print("kobiQ is not running and kobiQ is not installed", file=sys.stderr)
        return 1

    log(args.verbose, f"falling back to {kobiq} --toggle")
    os.execv(kobiq, [kobiq, "--toggle"])


if __name__ == "__main__":
    sys.exit(main())
